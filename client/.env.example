VITE_API_URL=https://finalecommercewebsite-backend.onrender.com/api

# Optional — Khalti public key for client-side Checkout widget fallback
# VITE_KHALTI_PUBLIC_KEY=test_public_key_xxxxxxxx

# Backend should implement (recommended):
#   POST /api/payments/initiate  { orderId, paymentMethod } → { paymentUrl } or { formAction, formFields }
#   POST /api/orders/:id/verify-payment  { ...gatewayParams }
# Success / failure return URLs for gateways:
#   https://your-frontend/payment/success?orderId=...
#   https://your-frontend/payment/failure?orderId=...
